# convo-engine environment variables
#
# Option A — Anthropic Claude (direct API)
# Requires @anthropic-ai/sdk peer dependency to be installed.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Option B — IBM Gateway (OpenAI-compatible, no Anthropic key needed)
# Use createGatewayProviderAdapter() which reads these automatically.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Set to 'false' when connecting directly to the gateway (self-signed cert).
# Leave unset or 'true' when going through the nginx proxy (CA-signed cert).
LLM_TLS_REJECT_UNAUTHORIZED=false
