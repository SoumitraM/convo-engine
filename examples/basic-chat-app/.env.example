# basic-chat-app — environment variables
#
# Copy this file to .env and fill in the values.
#
# Option A — Anthropic Claude (direct API)
# Requires @anthropic-ai/sdk to be installed in the parent package.
# ANTHROPIC_API_KEY=sk-ant-...
#
# Option B — IBM Gateway (OpenAI-compatible, no Anthropic key needed)
# Uses GatewayProviderAdapter — no extra peer dependencies.
LLM_BASE_URL=https://model-gateway-model-gateway.apps.f73l056.fusion.tadn.ibm.com
LLM_API_KEY=IsfPassw0rd
LLM_MODEL=qwen2-5-72b-instruct
# Set to 'false' when connecting directly to the gateway (self-signed cert).
# Also set NODE_TLS_REJECT_UNAUTHORIZED=0 in Node 22+ (built-in fetch ignores the agent option).
LLM_TLS_REJECT_UNAUTHORIZED=false
